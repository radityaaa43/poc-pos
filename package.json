{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test -c tests/e2e/playwright.config.js",
        "test:e2e:ui": "playwright test -c tests/e2e/playwright.config.js --ui",
        "e2e:up": "docker compose --profile e2e up -d app-e2e && npm run build && npm run e2e:reset",
        "e2e:reset": "node tests/e2e/support/cli.js e2e:reset",
        "e2e:new": "node tests/e2e/support/new-feature.js",
        "test:e2e:scaffold": "node --test tests/e2e/support/new-feature.test.mjs",
        "lint": "eslint resources/js --suppressions-location eslint-suppressions.gen.json"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^3.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/forms": "^0.5.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@vitejs/plugin-react": "^4.3.0",
        "@vitest/coverage-v8": "^3.2.7",
        "autoprefixer": "^10.4.12",
        "axios": "^1.6.4",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.8",
        "globals": "^17.14.0",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^1.0",
        "postcss": "^8.4.31",
        "react": "^19.0",
        "react-dom": "^19.0",
        "tailwindcss": "^3.2.1",
        "vite": "^5.0",
        "vitest": "^3.2.7"
    },
    "dependencies": {
        "@tabler/icons-react": "^3.5.0",
        "chart.js": "^4.5.1",
        "driver.js": "^1.8.0",
        "html5-qrcode": "^2.3.8",
        "i18next": "^26.3.6",
        "i18next-browser-languagedetector": "^8.2.1",
        "idb": "^8.0.3",
        "jsbarcode": "^3.12.1",
        "puppeteer": "^25.2.0",
        "react-hot-toast": "^2.4.1",
        "react-i18next": "^17.0.11",
        "sweetalert2": "^11.11.1"
    }
}
